msgstr "требование плагина -> elgg-plugin"

#: ../../appendix/upgrade-notes/3.x-to-4.0.rst:284
msgid "plugin position requirement -> elgg-plugin"
msgstr "требование позиции плагина -> elgg-plugin"

#: ../../appendix/upgrade-notes/3.x-to-4.0.rst:286
msgid "plugin version -> elgg-plugin"
msgstr "версия плагина -> elgg-plugin"

#: ../../appendix/upgrade-notes/3.x-to-4.0.rst:287
msgid "plugin activate on install -> elgg-plugin"
msgstr "активация плагина при установке -> elgg-plugin"

#: ../../appendix/upgrade-notes/3.x-to-4.0.rst:288
msgid "plugin name -> elgg-plugin"
msgstr "имя плагина -> elgg-plugin"

#: ../../appendix/upgrade-notes/3.x-to-4.0.rst:289
msgid "plugin description -> composer.json"
msgstr "описание плагина -> composer.json"

#: ../../appendix/upgrade-notes/3.x-to-4.0.rst:290
msgid "plugin categories -> composer.json"
msgstr "категории плагина -> composer.json"

#: ../../appendix/upgrade-notes/3.x-to-4.0.rst:291
msgid "plugin license -> composer.json"
msgstr "лицензия плагина -> composer.json"

#: ../../appendix/upgrade-notes/3.x-to-4.0.rst:292
msgid "plugin repo link -> composer.json"
msgstr "ссылка на репозиторий плагина -> composer.json"

#: ../../appendix/upgrade-notes/3.x-to-4.0.rst:293
msgid "plugin issues link -> composer.json"
msgstr "ссылка на баг-трекер плагина -> composer.json"

#: ../../appendix/upgrade-notes/3.x-to-4.0.rst:294
